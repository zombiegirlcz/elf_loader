#!/system/bin/sh
# parrot - run a parrot/Linux aarch64 binary on Android via the own-loading
# glibc loader (no proot / no qemu).  The kernel is shared; the parrot libc
# and all dependencies are loaded and relocated by /system/bin/elf_loader.
#
# usage: parrot <command> [args...]
#        parrot-sh            interactive parrot shell (bash)

ROOTFS=$(cat /data/adb/parrot_root 2>/dev/null)
[ -n "$ROOTFS" ] && [ -d "$ROOTFS" ] || ROOTFS=/data/adb/parrot
if [ ! -d "$ROOTFS" ]; then
    echo "parrot: rootfs not found at $ROOTFS" >&2
    echo "        run: echo /path/to/rootfs > /data/adb/parrot_root" >&2
    exit 127
fi

LIBDIR=$ROOTFS/usr/lib/aarch64-linux-gnu
LOADER=/system/bin/elf_loader

if [ -z "$1" ]; then
    echo "usage: parrot <command> [args...]" >&2
    exit 1
fi

cmd="$1"
shift
case "$cmd" in
    /*) bin="$ROOTFS$cmd" ;;
    *)  bin="$ROOTFS/usr/bin/$cmd"
        [ -x "$bin" ] || bin="$ROOTFS/bin/$cmd" ;;
esac
if [ ! -x "$bin" ]; then
    echo "parrot: $cmd: not found" >&2
    exit 127
fi

export LD_LIBRARY_PATH=$LIBDIR
export PATH="$ROOTFS/usr/bin:$ROOTFS/bin:/system/bin"
export HOME=/root
export TERM=xterm-256color

exec "$LIBDIR/ld-linux-aarch64.so.1" \
    --library-path "$LIBDIR" \
    "$LOADER" --ownall "$bin" "$@"