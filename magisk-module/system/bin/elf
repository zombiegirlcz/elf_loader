#!/system/bin/sh
if [ -z "$ROOTFS" ]; then
    echo "elf: ROOTFS not set. export ROOTFS=/path/to/rootfs" >&2
    exit 1
fi
# The bionic loader (this elf_loader binary) must resolve its OWN libc.so /
# libdl.so from the Android system, NOT from the parrot glibc dir -- otherwise
# the bionic linker chokes on parrot's libc.so (a GNU ld script: bad ELF
# magic). Put /system/lib64 first so the OUTER loader finds bionic libc.so,
# then append the parrot glibc libdirs for the INNER glibc loader (which looks
# for libc.so.6 etc. and only matches parrot, never bionic's libc.so).
export LD_LIBRARY_PATH="/system/lib64:/system/lib:$LD_LIBRARY_PATH:$ROOTFS/usr/lib/aarch64-linux-gnu:$ROOTFS/lib"
# Exec elf_loader from NEXT TO THIS SCRIPT (same dir as $0) -- NOT /system/bin,
# which may hold an outdated copy.
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec "$SELF_DIR/elf_loader" --ownall "$@"