#!/system/bin/sh
# elf - spustí glibc binárku z parrot rootfs na Androidu
# Použití: elf ls -la /etc          (binárka najde v PATH)
#          elf /cesta/k/binarce     (nebo přímo cesta)

if [ -z "$ROOTFS" ]; then
    echo "elf: Neni nastavena ROOTFS. Spustte: export ROOTFS=/cesta/k/rootfs" >&2
    exit 1
fi

# bionic knihovny prvni (pro elf_loader samotny), parrot glibc az za nimi
export LD_LIBRARY_PATH="/system/lib64:/system/lib:$LD_LIBRARY_PATH:$ROOTFS/usr/lib/aarch64-linux-gnu:$ROOTFS/lib"

# První argument BEZ "/" (např. "nmap") -> najít skutečnou cestu.
# elf_loader totiž umí otevřít jen cestu k souboru, ne hledat v PATH.
# Hledáme v rootfs adresářích + vedle wrapperu (mksh nespolehlive splituje
# IFS=: ve for, proto explicitní seznam).
resolve() {
    case "$1" in */*) echo "$1"; return 0;; esac
    for _d in "$ROOTFS/usr/bin" "$ROOTFS/bin" "$ROOTFS/usr/sbin" \
              "$ROOTFS/sbin" "${0%/*}"; do
        if [ -x "$_d/$1" ]; then echo "$_d/$1"; return 0; fi
    done
    return 1
}

case "$1" in
    */*|"") ;;
    *)
        if b=$(resolve "$1"); then
            shift
            set -- "$b" "$@"
        fi
        ;;
esac

# elf_loader se hledá v PATH
exec elf_loader --ownall "$@"
