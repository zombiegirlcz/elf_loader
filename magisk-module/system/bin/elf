#!/system/bin/sh
# elf - run parrot/Linux binaries via own-loading glibc loader
# Reads rootfs from /data/adb/parrot_root and sets up library path.

ROOTFS=$(head -1 /data/adb/parrot_root 2>/dev/null)
if [ -z "$ROOTFS" ] || [ ! -d "$ROOTFS" ]; then
    echo "elf: rootfs not configured (missing /data/adb/parrot_root)" >&2
    exit 1
fi

LIBDIR="$ROOTFS/usr/lib/aarch64-linux-gnu"
if [ ! -d "$LIBDIR" ]; then
    LIBDIR="$ROOTFS/lib"
fi

exec /system/bin/elf_loader --library-path "$LIBDIR" --ownall "$@"