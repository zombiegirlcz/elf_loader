#!/system/bin/sh
# bzsh - launcher for the bundled bionic-native zsh (NDK build, 5.9.2).
#
# Runs directly on the bionic host - no glibc, no elf_loader. This is the
# *host* shell; guest binaries are run through `lx` (see elf_loader init zsh).
#
# Support files (terminfo + zshrc) are not visible via the Magisk mount inside
# app/isolated namespaces, so customize.sh/service.sh copy them to
# /data/adb/zsh-bionic the same way the zsh binary is copied to /data/adb.

SUPPORT=/data/adb/zsh-bionic
[ -d "$SUPPORT" ] || SUPPORT=/system/etc/zsh-bionic

export ZSH_SUPPORT="$SUPPORT"
export TERMINFO="$SUPPORT/terminfo"
export ZDOTDIR="$SUPPORT"

ZSH_BIN=/data/adb/zsh
[ -x "$ZSH_BIN" ] || ZSH_BIN=/system/bin/zsh

exec "$ZSH_BIN" "$@"