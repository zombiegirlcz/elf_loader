# ELF Loader - bionic host zsh (NDK build) rc.
#
# Tohle je HOST shell (bzsh): bezi primo na bionic, zadny glibc, zadny loader.
# Kdyz je nakonfigurovany rootfs, `elf_loader init zsh` doda cely guest
# toolkit (lx, lxwhich, lxdw, init env) a nakonec nacte ~/.elfrc, kde jsou
# starship / zoxide / vlastni aliasy.

[[ "$PS1" == '%m%# ' ]] && PS1='%# '

: ${ZSH_SUPPORT:=/data/adb/zsh-bionic}
export ZSH_SUPPORT

# loader: /system/bin (Magisk mount) -> /data/adb (kopie, vidi ji i app ns)
if [ -x /system/bin/elf_loader ]; then
    _el=/system/bin/elf_loader
elif [ -x /data/adb/elf_loader ]; then
    _el=/data/adb/elf_loader
else
    _el=$(command -v elf_loader 2>/dev/null)
fi

if [ -n "$_el" ] && [ -x "$_el" ]; then
    # eval init: D/ROOTFS/L/R/LX_LOG + lx/lxwhich/lxdw + ~/.elfrc (starship/zoxide)
    eval "$("$_el" init zsh 2>/dev/null)"
fi
unset _el

