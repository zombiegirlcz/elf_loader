#!/system/bin/sh
# parrot-fix-exec - enable fork/exec of parrot binaries from inside a parrot
# shell (experimental).
#
# Android's root filesystem is read-only (often dm-verity), so the kernel
# cannot find the interpreter "/lib/ld-linux-aarch64.so.1" that parrot
# binaries embed.  This script makes it work WITHOUT touching /:
#
#   1) places the interpreter bridge (a small static re-exec wrapper) at
#      /data/local/tmp/ldl (a writable path), and
#   2) rewrites the PT_INTERP string of every rootfs ELF to that path.
#
# NOTE: step 2 MODIFIES the rootfs binaries in place.  The rootfs then no
# longer works inside a plain Linux chroot.  A backup of each modified file
# is saved next to it as <file>.interp.bak (restore with parrot-fix-exec -r).
#
# usage: parrot-fix-exec         patch (enable)
#        parrot-fix-exec -r      restore from backups

ROOTFS=$(head -1 /data/adb/parrot_root 2>/dev/null)
[ -n "$ROOTFS" ] && [ -d "$ROOTFS" ] || ROOTFS=/data/adb/parrot
if [ ! -d "$ROOTFS" ]; then
    echo "parrot-fix-exec: rootfs not found at $ROOTFS" >&2
    exit 127
fi

BRIDGE=/data/local/tmp/ldl
if [ -f /data/adb/modules/parrot_elf_loader/system/lib/ld-linux-aarch64.so.1 ]; then
    BRIDGE_SRC=/data/adb/modules/parrot_elf_loader/system/lib/ld-linux-aarch64.so.1
elif [ -f /system/lib/ld-linux-aarch64.so.1 ]; then
    BRIDGE_SRC=/system/lib/ld-linux-aarch64.so.1
else
    BRIDGE_SRC=$(dirname "$0")/ld-linux-aarch64.so.1
fi

restore_all() {
    echo "restoring backups..."
    find "$ROOTFS/bin" "$ROOTFS/sbin" "$ROOTFS/usr/bin" "$ROOTFS/usr/sbin" \
        "$ROOTFS/usr/lib" "$ROOTFS/lib" -name '*.interp.bak' -type f 2>/dev/null |
    while read -r b; do
        orig=${b%.interp.bak}
        cp -f "$b" "$orig" 2>/dev/null && rm -f "$b"
    done
    echo "done. interpreter rewrites reverted (new binaries keep the old PT_INTERP)."
    exit 0
}

[ "$1" = "-r" ] && restore_all

echo "placing interpreter bridge at $BRIDGE..."
mkdir -p /data/local/tmp
if [ -f "$BRIDGE_SRC" ]; then
    cp -f "$BRIDGE_SRC" "$BRIDGE" && chmod 755 "$BRIDGE"
else
    echo "bridge binary not found ($BRIDGE_SRC)" >&2
    exit 127
fi

PATCHER=/data/local/tmp/patchelf_interp
if [ ! -x "$PATCHER" ]; then
    SRCP=$(find /data/adb/modules/parrot_elf_loader /system/bin -name patchelf_interp 2>/dev/null | head -1)
    [ -n "$SRCP" ] && cp -f "$SRCP" "$PATCHER" && chmod 755 "$PATCHER"
fi
if [ ! -x "$PATCHER" ]; then
    echo "patchelf_interp tool not found" >&2
    exit 127
fi

echo "patching PT_INTERP in rootfs ELFs (backing up originals)..."
find "$ROOTFS/bin" "$ROOTFS/sbin" "$ROOTFS/usr/bin" "$ROOTFS/usr/sbin" \
    -type f -size +100c 2>/dev/null |
while read -r f; do
    if head -c4 "$f" 2>/dev/null | grep -q "$(printf '\177ELF')"; then
        [ -f "$f.interp.bak" ] || cp -f "$f" "$f.interp.bak" 2>/dev/null
        "$PATCHER" "$f" 2>/dev/null
    fi
done

echo
echo "done. fork/exec of parrot binaries should now work inside parrot-sh."
echo "to revert: parrot-fix-exec -r"