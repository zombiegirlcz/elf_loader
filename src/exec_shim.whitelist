# exec_shim whitelist — one binary name (or full path) per line.
# Empty lines and lines starting with '#' are ignored.
#
# Binarky, ktere se pri exec re-routuji pres elf_loader (--ownall), aby bezely
# s parrot glibc misto primeho exec (PT_INTERP /lib/ld-linux-aarch64.so.1 na
# Androidu neexistuje). Pozn.: kazdy redirect i selhani se loguje do
# $ROOTFS/root/elf_loader/white.log (viz exec_shim.c white_log).
#
# POZN: starship je odstranen — funguje naprimo, nema smysl ho redirectovat.

# --- shell / zakladni ---
sh
bash
zsh
dash
env
which
command
id
whoami
groups
users
logname
tty

# --- dpkg / apt (fakeroot cesta) ---
dpkg
dpkg-deb
dpkg-query
dpkg-split
dpkg-trigger
dpkg-divert
dpkg-statoverride
apt
apt-get
apt-cache
apt-config
apt-key
apt-mark
start-stop-daemon
update-alternatives
update-rc.d
invoke-rc.d
debconf

