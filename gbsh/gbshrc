# ~/.gbshrc - gbsh (Ghost/Bionic Shell) config
#
# POZOR: gbsh NENI zsh. NEPOUZIVEJ tyto konstrukce (shodi gbsh do segfaultu):
#   - command substitution $(...)
#   - source neexistujiciho souboru
#   - zsh pluginy (zsh-syntax-highlighting, zsh-autosuggestions)
#   - setopt / zstyle s vice argumenty
# Starship prompt je v gbsh integrovan NATIVNE pres GBSH_PROMPT_MODE=starship
# (gbsh.c -> try_starship_prompt() spusti `elf_loader --ownall .../starship prompt`).

# === Prostredi ===
export EDITOR=nano
export PAGER=less
export HISTSIZE=1000
export GBSH_EXEC_MODE=shim
export GBSH_PROMPT_MODE=starship

# Terminfo z rootfs (jen kdyz existuje)
[ -n "$ROOTFS" ] && export TERMINFO="$ROOTFS/usr/share/terminfo"

# Starship config z rootfs (jen kdyz existuje)
[ -n "$ROOTFS" ] && [ -f "$ROOTFS/etc/starship.toml" ] && export STARSHIP_CONFIG="$ROOTFS/etc/starship.toml"

# Fallback prompt (kdyz starship selze)
export GBSH_PROMPT='\e[1;32m%u@%h\e[0m:\e[36m%~\e[0m$ '

# === Aliasy ===
alias ls='ls --color=auto'
alias ll='ls -la'
alias la='ls -A'
alias l='ls -CF'
alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias ..='cd ..'
alias ...='cd ../..'
alias h='history'
alias md='mkdir -p'
alias rd='rmdir'
alias reload='source ~/.gbshrc'
