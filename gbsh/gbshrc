# ~/.gbshrc — gbsh konfigurace
#
# ═══ OBRÁCENÝ SVĚT (dual-world) ═══
#   /           = kořen distro (parrot)     [start]
#   cd .. z "/" = překlopí tě NA DRUHOU STRANU → host Android filesystem
#   cd /parrot  = v host světě se vrátíš dovnitř do distra
#   ROOTFS_SYMBOL=... změní vstupní symbol (default /parrot)
# V rootfs světě běží parrot příkazy přes elf_loader own-loading.
# V host světě běží nativní Android (toybox) příkazy.
# Procesy vidí pravdu — nelžeme jim o hranici SW/HW.

export GBSH_PROMPT='\x1b[1;32m%u@%h\x1b[0m:\x1b[36m%~\x1b[0m$ '
export HOST_ENTRY=$HOME

# ── aliasy fungují v obou světech ──
alias ll='ls -la'
alias la='ls -a'
alias grep='grep --color=auto'
alias ..='cd ..'

# tip: v rootfs světě je PATH distro; v host světě /system/bin.
# "cd /parrot && apt update" = vstup do distra a spustí apt.
