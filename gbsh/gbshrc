# ~/.gbshrc — gbsh konfigurace (provádí se při startu)
# Barvy: ANSI escape lze psát přímo do GBSH_PROMPT

# ── prompt (barevný) ──
export GBSH_PROMPT='[1;32m%u@%h[0m:[36m%~[0m$ '

# ── prostředí ──
export EDITOR=vi
export PAGER=less
export LS_COLORS='di=01;34:ln=01;36:ex=01;32'

# ── aliasy ──
alias ll='ls -la'
alias la='ls -a --color=auto'
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias ..='cd ..'
alias ...='cd ../..'
alias cls='clear'

# parrot zkratky (běží přes elf_loader own-loading, plné barvy)
alias llp='ls -la'
alias papt='apt --help'

# syntax highlight ve vstupu je zapnutý vždy (TTY režim):
#   zelená = builtin, žlutá = operátor |;&<>,
#   tyrkysová = flagy/cesty, červená = $VAR, magenta = "stringy"
