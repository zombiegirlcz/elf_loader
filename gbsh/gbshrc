# ~/.gbshrc — gbsh konfigurace
#
# ═══ OBRÁCENÝ SVĚT ═══ (aktivace: gbsh --double-world nebo -dw)
#   /           = kořen distro (parrot)            [start]
#   cd .. z "/" = překlopí tě do FYZICKÉHO RODIČE rootfs
#                 ($ROOTFS=/data/…/nh/distro/parrot → cd .. = …/nh/distro)
#   cd $ROOTFS  = návrat dovnitř do distra (funguje odkudkoli,
#                 i s hloubkou: cd $ROOTFS/usr/bin)
#   V host světě prompt ukazuje skutečnou Android cestu.
#
# Prompt: \e = escape, \n \t, \\xNN hex; %u %h %~ \$
export GBSH_PROMPT='\e[1;32m%u@%h\e[0m:\e[36m%~\e[0m$ '

export EDITOR=vi
export PAGER=less

alias ll='ls -la'
alias la='ls -a'
alias grep='grep --color=auto'
alias ..='cd ..'
